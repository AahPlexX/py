{
  "name": "python-mastery-course",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:gh-pages": "GITHUB_PAGES=true tsc -b && GITHUB_PAGES=true vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validate:course": "vitest run --reporter=verbose src/tests/course-graph.test.ts src/tests/lesson-schema.test.ts"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@codemirror/lang-python": "6.2.1",
    "@tanstack/react-router": "1.170.13",
    "@uiw/react-codemirror": "4.25.10",
    "lucide-react": "1.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/router-vite-plugin": "1.167.16",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/ui": "4.1.8",
    "eslint": "9.29.0",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.34.0",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
